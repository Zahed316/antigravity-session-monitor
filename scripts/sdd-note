#!/usr/bin/env bash
# sdd-note: append one line to the active SDD progress ledger and print its path.
set -uo pipefail
if [ $# -ne 1 ]; then
  echo 'usage: sdd-note "<text>"' >&2
  exit 1
fi
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ -n "${SDD_LEDGER:-}" ]; then
  ledger="$SDD_LEDGER"
else
  ledger="$(ls -t "$repo_root"/.superpowers/sdd/*/progress.md 2>/dev/null | head -n 1)"
  if [ -z "$ledger" ]; then
    ledger="$repo_root/.superpowers/sdd/plan/progress.md"
  fi
fi
mkdir -p "$(dirname "$ledger")"
printf '%s\n' "$1" >> "$ledger"
printf '%s\n' "$ledger"
