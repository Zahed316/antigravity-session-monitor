#!/usr/bin/env bash
# sdd-verify: fail-fast session gate — run check, test, build in the caller's
# cwd; on the first failure print FAIL <command> plus its last 20 lines, exit 1.
# (No `set -e` needed: run() handles failures explicitly.)
set -uo pipefail

run() {
  local name="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    printf 'PASS %s\n' "$name"
  else
    printf 'FAIL %s\n' "$name"
    printf '%s\n' "$out" | tail -n 20
    exit 1
  fi
}

run "npm run check" npm run check
run "npm test" npm test
run "npm run build" npm run build
printf 'OK\n'
