{
  "name": "antigravity-session-monitor",
  "displayName": "GravityWatch for Antigravity",
  "description": "GravityWatch — read-only live status bar and bottom panel for Antigravity session context windows, subagent token rollups, and 5h/weekly quota pools.",
  "icon": "logo.png",
  "publisher": "Zahed-r",
  "version": "0.1.8",
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Zahed316/antigravity-session-monitor.git"
  },
  "keywords": [
    "antigravity",
    "gravitywatch",
    "quota",
    "context window",
    "tokens",
    "subagent",
    "telemetry",
    "gemini"
  ],
  "galleryBanner": {
    "color": "#0A0E20",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/VS_Code_Marketplace-v0.1.8-007ACC?logo=visualstudiocode",
      "href": "https://marketplace.visualstudio.com/items?itemName=Zahed-r.antigravity-session-monitor",
      "description": "Marketplace version"
    },
    {
      "url": "https://img.shields.io/badge/License-MIT-blue.svg",
      "href": "https://github.com/Zahed316/antigravity-session-monitor/blob/main/LICENSE",
      "description": "License"
    },
    {
      "url": "https://img.shields.io/github/stars/Zahed316/antigravity-session-monitor?style=flat",
      "href": "https://github.com/Zahed316/antigravity-session-monitor/stargazers",
      "description": "GitHub stars"
    }
  ],
  "qna": "marketplace",
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "test": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "package": "vsce package --allow-missing-repository"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "antigravity-monitor",
          "title": "Antigravity Monitor",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "antigravity-monitor": [
        {
          "type": "webview",
          "id": "antigravityMonitor.panel",
          "name": "Antigravity Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityMonitor.openQuickPick",
        "title": "Select or Pin Session",
        "category": "Antigravity Monitor"
      },
      {
        "command": "antigravityMonitor.openPanel",
        "title": "Open Bottom Panel",
        "category": "Antigravity Monitor"
      },
      {
        "command": "antigravityMonitor.pinSession",
        "title": "Pin Session to Status Bar",
        "category": "Antigravity Monitor"
      },
      {
        "command": "antigravityMonitor.unpinSession",
        "title": "Unpin Session (Auto-Track)",
        "category": "Antigravity Monitor"
      },
      {
        "command": "antigravityMonitor.toggleScope",
        "title": "Toggle Workspace Scope",
        "category": "Antigravity Monitor"
      },
      {
        "command": "antigravityMonitor.refresh",
        "title": "Refresh Telemetry",
        "category": "Antigravity Monitor",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Antigravity Session Monitor",
      "properties": {
        "antigravityMonitor.refreshIntervalMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "description": "Telemetry and quota refresh interval in milliseconds while VS Code is focused."
        },
        "antigravityMonitor.unfocusedRefreshIntervalMs": {
          "type": "number",
          "default": 30000,
          "minimum": 2000,
          "description": "Telemetry and quota refresh interval in milliseconds while VS Code is unfocused."
        },
        "antigravityMonitor.quotaRefreshIntervalMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "description": "Interval (ms) for polling quota and model usage from the local Antigravity hub (minimum 5000ms). Decoupled from local session telemetry polling."
        },
        "antigravityMonitor.quotaUnfocusedMultiplier": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 12,
          "description": "Multiplier applied to quotaRefreshIntervalMs while VS Code is unfocused (e.g., 2 = 2x slower; 0 pauses the timer-driven quota polling while unfocused - a manual refresh still polls)."
        },
        "antigravityMonitor.autoFollowActiveSession": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch the Details tab to follow the active Antigravity conversation when switching conversations."
        },
        "antigravityMonitor.contextWarningPct": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 100,
          "description": "Context window usage percentage threshold for warning Status Bar highlight."
        },
        "antigravityMonitor.contextCriticalPct": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 100,
          "description": "Context window usage percentage threshold for critical Status Bar highlight."
        },
        "antigravityMonitor.defaultScope": {
          "type": "string",
          "enum": [
            "current",
            "all"
          ],
          "default": "current",
          "description": "Default session scope in QuickPick and the Bottom Panel."
        },
        "antigravityMonitor.dataRootOverride": {
          "type": "string",
          "default": "",
          "description": "Optional override directory for Antigravity local data (defaults to ~/.gemini/antigravity)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.99.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
